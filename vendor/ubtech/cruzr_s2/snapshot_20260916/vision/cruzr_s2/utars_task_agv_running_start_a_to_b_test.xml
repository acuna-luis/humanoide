<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="test">
  <BehaviorTree ID="test">
    <ParallelAll name="root"
                 max_failures="1">
      <ForceSuccess>
        <TtsClient tts="我要开始工作啦"/>
      </ForceSuccess>
      <SetTaskStateServer set_running="false"/>
      <Script code=" taskControl:=&apos;void&apos;"/>
      <Script code=" flysky:=1"/>
      <RemoteControlNode taskControl="{taskControl}"/>
      <TaskSequenceNode taskControl="{taskControl}"
                        finish="false">
        <Repeat num_cycles="1000">
          <SequenceWithMemory>
            <Sequence _description="11111">
              <Sequence>
                <SetTaskStateServer set_running="true"/>
                <Delay delay_msec="3000">
                  <AgvChargeBatteryPowerStatusCondition battery_power="{battery_low_power}"
                                                        battery_charge_state="{battery_charge_state}"
                                                        _description="battery_charge_state #充电桩工作状态  #空闲 0  充电中 1"/>
                </Delay>
                <Sequence _skipIf="battery_charge_state!=&quot;0&quot; || battery_low_power&gt;15">
                  <SetTaskStateServer set_running="false"/>
                  <ForceFailure>
                    <TtsClient tts="当前电池电量低于百分之15，拒绝执行任务"/>
                  </ForceFailure>
                </Sequence>
                <Sequence _skipIf="battery_charge_state!=&quot;1&quot; || battery_low_power&gt;40">
                  <SetTaskStateServer set_running="false"/>
                  <ForceFailure>
                    <TtsClient tts="正在充电,当前电池电量低于百分之40，拒绝执行任务"/>
                  </ForceFailure>
                </Sequence>
                <Sequence _description="导航重定位判断节点">
                  <MappingNameGain command="get_map_name"
                                   map_name="utars_charge_map"
                                   map_self="{map_self_str}"
                                   _description="检测地图是否存在"/>
                  <Sequence>
                    <Sequence _description="检测是否设置了这个地图:1.已设置该地图"
                              _skipIf="map_self_str!=&quot;1&quot;">
                      <TtsClient tts="检测地图"/>
                      <Sequence>
                        <NavigationCheck command="check_state"
                                         nav_code="{nav_code_str}"
                                         map_self="{map_self_str}"
                                         _description="获取地图code"/>
                      </Sequence>
                    </Sequence>
                    <Sequence _description="表示没有设置这个地图,0.未设置该地图"
                              _skipIf="map_self_str!=&quot;0&quot;">
                      <TtsClient tts="设置地图"/>
                      <Fallback>
                        <MappingOperations command="map_set"
                                           map_name="utars_charge_map"
                                           nav_error="{map_set_error_msg}"/>
                        <ForceFailure>
                          <Sequence>
                            <TtsClient tts="{map_set_error_msg}"/>
                          </Sequence>
                        </ForceFailure>
                      </Fallback>
                      <Fallback>
                        <RetryUntilSuccessful num_attempts="3">
                          <Sequence>
                            <RelocationActuator command="relocation_start"
                                                mode="global"
                                                relocation_x="0"
                                                relocation_y="0"
                                                relocation_z="0"
                                                nav_error="{relocation_error_msg}"/>
                          </Sequence>
                        </RetryUntilSuccessful>
                        <ForceFailure>
                          <Sequence>
                            <TtsClient tts="{relocation_error_msg}"/>
                          </Sequence>
                        </ForceFailure>
                      </Fallback>
                    </Sequence>
                  </Sequence>
                  <Sequence _skipIf="nav_code_str!=&quot;1200006&quot; &amp;&amp; nav_code_str!=&quot;1200007&quot;">
                    <ForceSuccess>
                      <TtsClient tts="导航定位成功"/>
                    </ForceSuccess>
                  </Sequence>
                </Sequence>
                <Sequence _description="在充电状态，并且电量大于40%符合工作条件，&#10;发送缩桩操作，如果还通电，则说明是手动充电"
                          _skipIf="battery_charge_state!=&quot;1&quot; || battery_low_power&lt;=40">
                  <Sequence>
                    <ForceSuccess>
                      <RetryUntilSuccessful num_attempts="3">
                        <Fallback>
                          <AgvChargePoleClient type="0"
                                               ip="192.168.42.168"
                                               pole_message="{pole_message}"/>
                          <ForceFailure>
                            <Sequence>
                              <ForceSuccess>
                                <Delay delay_msec="1500">
                                  <TtsClient tts="{pole_message}"/>
                                </Delay>
                              </ForceSuccess>
                            </Sequence>
                          </ForceFailure>
                        </Fallback>
                      </RetryUntilSuccessful>
                    </ForceSuccess>
                    <Delay delay_msec="10000">
                      <AgvChargeBatteryPowerStatusCondition battery_power="{battery_low_power}"
                                                            battery_charge_state="{battery_charge_state}"
                                                            _description="battery_charge_state #充电桩工作状态  #空闲 0  充电中 1"/>
                    </Delay>
                    <Sequence _skipIf="battery_charge_state!=&quot;1&quot;">
                      <SetTaskStateServer set_running="false"/>
                      <ForceFailure>
                        <TtsClient tts="当前机器人连接充电器，拒绝执行任务"/>
                      </ForceFailure>
                    </Sequence>
                    <Sequence _description="由上桩状态转为下桩状态&#10;"
                              _skipIf="battery_charge_state!=&quot;0&quot;">
                      <ForceSuccess>
                        <TtsClient tts="我要开始下桩操作"/>
                      </ForceSuccess>
                    </Sequence>
                  </Sequence>
                </Sequence>
              </Sequence>
            </Sequence>
            <Sequence>
              <ManipulationAction task_name="cruzr/home"
                                  yaml_args=""/>
              <ManipulationAction task_name="vision/enable_transport_vision_switch"
                                  yaml_args=""/>
            </Sequence>
            <Sequence _description="充电操作">
              <Sequence _description="搬上面层大箱子操作">
                <RetryUntilSuccessful num_attempts="5">
                  <Fallback>
                    <NavigationActuator command="navigation_start"
                                        mode="logo_nav"
                                        target_id="put1"
                                        nav_error="{to_put_error_msg}"/>
                    <ForceFailure>
                      <Sequence>
                        <Delay delay_msec="1000">
                          <ForceSuccess>
                            <TtsClient tts="{to_put_error_msg}"/>
                          </ForceSuccess>
                        </Delay>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>
                <Delay delay_msec="200">
                  <ManipulationAction task_name="cruzr/back_sit"
                                      yaml_args=""/>
                </Delay>
              </Sequence>
              <Sequence _description="开始充电">
                <Delay delay_msec="5000">
                  <ForceSuccess>
                    <TtsClient tts="后坐完成"/>
                  </ForceSuccess>
                </Delay>
              </Sequence>
              <Sequence _description="搬上面层大箱子操作">
                <RetryUntilSuccessful num_attempts="5">
                  <Fallback>
                    <NavigationActuator command="navigation_start"
                                        mode="logo_nav"
                                        target_id="put2"
                                        nav_error="{to_put_error_msg}"/>
                    <ForceFailure>
                      <Sequence>
                        <Delay delay_msec="1000">
                          <ForceSuccess>
                            <TtsClient tts="{to_put_error_msg}"/>
                          </ForceSuccess>
                        </Delay>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>
                <Delay delay_msec="200">
                  <ManipulationAction task_name="cruzr/home"
                                      yaml_args=""/>
                </Delay>
              </Sequence>
              <Sequence _description="开始充电">
                <Delay delay_msec="5000">
                  <ForceSuccess>
                    <TtsClient tts="回零完成"/>
                  </ForceSuccess>
                </Delay>
              </Sequence>
              <SetTaskStateServer set_running="false"/>
            </Sequence>
          </SequenceWithMemory>
        </Repeat>
      </TaskSequenceNode>
    </ParallelAll>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AgvChargeBatteryPowerStatusCondition"
            editable="true">
      <inout_port name="battery_power">当前机器电池电量值</inout_port>
      <inout_port name="battery_charge_state">当前机器电池是否在充电（1为是，0为否）</inout_port>
    </Action>
    <Action ID="AgvChargePoleClient"
            editable="true">
      <input_port name="type"
                  default="1"/>
      <input_port name="ip"
                  default="192.168.11.99"/>
      <output_port name="pole_message"/>
    </Action>
    <Action ID="ManipulationAction"
            editable="true">
      <input_port name="task_name"/>
      <input_port name="yaml_args"/>
    </Action>
    <Action ID="MappingNameGain"
            editable="true">
      <input_port name="command"/>
      <input_port name="map_name"/>
      <input_port name="map_self"/>
    </Action>
    <Action ID="MappingOperations"
            editable="true">
      <input_port name="command"/>
      <input_port name="map_name"/>
      <inout_port name="nav_error"/>
    </Action>
    <Action ID="NavigationActuator"
            editable="true">
      <input_port name="command"/>
      <input_port name="mode"/>
      <input_port name="target_id"/>
      <input_port name="nav_error"/>
    </Action>
    <Action ID="NavigationCheck"
            editable="true">
      <input_port name="command"/>
      <input_port name="nav_code"/>
      <input_port name="map_self"/>
    </Action>
    <Action ID="RelocationActuator"
            editable="true">
      <input_port name="command"/>
      <input_port name="mode"/>
      <input_port name="relocation_x"/>
      <input_port name="relocation_y"/>
      <input_port name="relocation_z"/>
      <inout_port name="nav_error"/>
    </Action>
    <Action ID="RemoteControlNode"
            editable="true">
      <input_port name="taskControl"/>
    </Action>
    <Action ID="SetTaskStateServer"
            editable="true">
      <input_port name="set_running"/>
    </Action>
    <Decorator ID="TaskSequenceNode"
               editable="true">
      <input_port name="taskControl"/>
      <input_port name="finish"/>
    </Decorator>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
  </TreeNodesModel>

</root>
