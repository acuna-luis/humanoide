<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="test">
  <BehaviorTree ID="test">
    <ParallelAll name="root"
                 max_failures="1">
      <TtsClient tts="我要开始工作啦"/>
      <Script code=" taskControl:=&apos;void&apos;"/>
      <Script code=" flysky:=1"/>
      <RemoteControlNode taskControl="{taskControl}"/>
      <TaskSequenceNode taskControl="{taskControl}"
                        finish="false">
        <SequenceWithMemory>
          <Sequence>
            <TtsClient tts="设置地图"/>
            <TtsClient tts="导航定位成功"/>
          </Sequence>
          <Sequence _description="充电操作">
            <Sequence _description="搬上面层大箱子操作">
              <TtsClient tts="我要开始上桩充电了"/>
              <RetryUntilSuccessful num_attempts="3">
                <Fallback>
                  <AgvChargePoleClient type="1"
                                       ip="192.168.42.168"
                                       pole_message="{pole_message}"/>
                  <ForceFailure>
                    <Delay delay_msec="1500">
                      <TtsClient tts="{pole_message}"/>
                    </Delay>
                  </ForceFailure>
                </Fallback>
              </RetryUntilSuccessful>
            </Sequence>
            <Sequence _description="开始上桩充电">
              <Delay delay_msec="15000">
                <TtsClient tts="我要开始接收数据了"/>
              </Delay>
              <RetryUntilSuccessful num_attempts="3">
                <Fallback>
                  <AgvChargeStatusClient agv_status_message="{agv_status_message}"/>
                  <ForceFailure>
                    <Sequence>
                      <Delay delay_msec="1500">
                        <TtsClient tts="{agv_status_message}"/>
                      </Delay>
                      <AgvChargePoleClient type="1"
                                           ip="192.168.42.168"
                                           pole_message="{pole_message}"/>
                    </Sequence>
                  </ForceFailure>
                </Fallback>
              </RetryUntilSuccessful>
              <Delay delay_msec="15000">
                <TtsClient tts="我要开始传输数据了"/>
              </Delay>
              <AgvChargeClient is_turn="0"
                               _description="0 充电机开启充电   1 充电机关闭输出"/>
            </Sequence>
            <Sequence _description="开始充电">
              <Delay delay_msec="25000">
                <TtsClient tts="我要开始下桩充电了"/>
              </Delay>
              <RetryUntilSuccessful num_attempts="3">
                <Fallback>
                  <AgvChargePoleClient type="0"
                                       ip="192.168.42.168"
                                       pole_message="{pole_message}"/>
                  <ForceFailure>
                    <Delay delay_msec="1500">
                      <TtsClient tts="{pole_message}"/>
                    </Delay>
                  </ForceFailure>
                </Fallback>
              </RetryUntilSuccessful>
            </Sequence>
          </Sequence>
        </SequenceWithMemory>
      </TaskSequenceNode>
    </ParallelAll>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AgvChargeClient"
            editable="true">
      <input_port name="is_turn"/>
    </Action>
    <Action ID="AgvChargePoleClient"
            editable="true">
      <input_port name="type"
                  default="1"/>
      <input_port name="ip"
                  default="192.168.11.99"/>
      <output_port name="pole_message"/>
    </Action>
    <Action ID="AgvChargeStatusClient"
            editable="true">
      <output_port name="agv_status_message"/>
    </Action>
    <Action ID="RemoteControlNode"
            editable="true">
      <input_port name="taskControl"/>
    </Action>
    <Decorator ID="TaskSequenceNode"
               editable="true">
      <input_port name="taskControl"/>
      <input_port name="finish"/>
    </Decorator>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
  </TreeNodesModel>

</root>
