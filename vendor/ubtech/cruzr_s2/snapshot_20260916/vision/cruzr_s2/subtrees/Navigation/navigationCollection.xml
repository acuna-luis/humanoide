<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="NavigationLocationAgv">
    <Sequence>
      <Sequence _description="带充电重定位">
        <Sequence>
          <Sequence _description="该节点配合上桩节点一起操作，上桩时候，设置true，上桩结束后要翻转false">
            <GlobalVarCondition set_global_str=""
                                current_global_str="{current_global_str}"/>
            <Sequence _skipIf="current_global_str!=&quot;1&quot;">
              <ForceFailure>
                <TtsClient tts="当前正在上桩充电，禁止执行任务"/>
              </ForceFailure>
            </Sequence>
          </Sequence>
          <SetTaskStateServer set_running="true"
                              _onSuccess="nav_code_str:=&quot;0&quot;"/>
          <Delay delay_msec="3000">
            <AgvChargeBatteryPowerStatusCondition battery_power="{battery_low_power}"
                                                  battery_charge_state="{battery_charge_state}"
                                                  _description="battery_charge_state #充电桩工作状态  #空闲 0  充电中 1"/>
          </Delay>
          <Sequence _skipIf="battery_charge_state!=&quot;0&quot; || battery_low_power&gt;15">
            <SetTaskStateServer set_running="false"/>
            <ForceFailure>
              <TtsClient tts="当前电池电量低于百分之15，拒绝执行任务"/>
            </ForceFailure>
          </Sequence>
          <Sequence _skipIf="battery_charge_state!=&quot;1&quot; || battery_low_power&gt;40">
            <SetTaskStateServer set_running="false"/>
            <ForceFailure>
              <TtsClient tts="正在充电,当前电池电量低于百分之40，拒绝执行任务"/>
            </ForceFailure>
          </Sequence>
          <ForceSuccess>
            <NavigationActuator command="navigation_stop"
                                mode=""
                                target_id=""
                                nav_error="{stop_navigation_error_msg}"/>
          </ForceSuccess>
          <Script code="map_self_str:=&quot;0&quot;"/>
          <Sequence _description="导航重定位判断节点">
            <MappingNameGain command="get_map_name"
                             map_name="utars_charge_map"
                             map_self="{map_self_str}"
                             _description="检测地图是否存在"/>
            <Sequence>
              <Sequence _description="检测是否设置了这个地图:1.已设置该地图"
                        _skipIf="map_self_str!=&quot;1&quot;">
                <TtsClient tts="检测地图"/>
                <Sequence>
                  <NavigationCheck command="check_state"
                                   nav_code="{nav_code_str}"
                                   map_self="{map_self_str}"
                                   _description="获取地图code"/>
                </Sequence>
              </Sequence>
              <Sequence _description="表示没有设置这个地图,0.未设置该地图"
                        _skipIf="map_self_str!=&quot;0&quot;">
                <TtsClient tts="设置地图"/>
                <Fallback>
                  <MappingOperations command="map_set"
                                     map_name="utars_charge_map"
                                     nav_error="{map_set_error_msg}"/>
                  <ForceFailure>
                    <Sequence>
                      <TtsClient tts="{map_set_error_msg}"/>
                    </Sequence>
                  </ForceFailure>
                </Fallback>
                <RetryUntilSuccessful num_attempts="3">
                  <Fallback>
                    <Sequence>
                      <Delay delay_msec="300">
                        <RelocationActuator command="relocation_start"
                                            mode="global"
                                            relocation_x="0"
                                            relocation_y="0"
                                            relocation_z="0"
                                            nav_error="{relocation_error_msg}"/>
                      </Delay>
                    </Sequence>
                    <ForceFailure>
                      <Sequence>
                        <TtsClient tts="{relocation_error_msg}"/>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>
              </Sequence>
            </Sequence>
            <Sequence _skipIf="nav_code_str!=&quot;1200006&quot; &amp;&amp; nav_code_str!=&quot;1200007&quot;">
              <ForceSuccess>
                <TtsClient tts="导航定位成功"/>
              </ForceSuccess>
            </Sequence>
          </Sequence>
          <Sequence _description="在充电状态，并且电量大于40%符合工作条件，&#10;发送缩桩操作，如果还通电，则说明是手动充电"
                    _skipIf="battery_charge_state!=&quot;1&quot; || battery_low_power&lt;=40">
            <Sequence>
              <ForceSuccess>
                <RetryUntilSuccessful num_attempts="3">
                  <Fallback>
                    <AgvChargePoleClient type="0"
                                         ip="192.168.42.168"
                                         pole_message="{pole_message}"/>
                    <ForceFailure>
                      <Sequence>
                        <ForceSuccess>
                          <Delay delay_msec="1500">
                            <TtsClient tts="{pole_message}"/>
                          </Delay>
                        </ForceSuccess>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>
              </ForceSuccess>
              <Delay delay_msec="10000">
                <AgvChargeBatteryPowerStatusCondition battery_power="{battery_low_power}"
                                                      battery_charge_state="{battery_charge_state}"
                                                      _description="battery_charge_state #充电桩工作状态  #空闲 0  充电中 1"/>
              </Delay>
              <Sequence _skipIf="battery_charge_state!=&quot;1&quot;">
                <SetTaskStateServer set_running="false"/>
                <ForceFailure>
                  <TtsClient tts="当前机器人连接充电器，拒绝执行任务"/>
                </ForceFailure>
              </Sequence>
              <Sequence _description="由上桩状态转为下桩状态&#10;"
                        _skipIf="battery_charge_state!=&quot;0&quot;">
                <ForceSuccess>
                  <TtsClient tts="我要开始下桩操作"/>
                </ForceSuccess>
              </Sequence>
            </Sequence>
          </Sequence>
          <ForceSuccess>
            <AgvChargePoleClient type="0"
                                 ip="192.168.42.168"
                                 pole_message="{pole_message}"/>
          </ForceSuccess>
        </Sequence>
      </Sequence>
      <ManipulationAction task_name="cruzr/home"
                          yaml_args=""
                          arm_error=""
                          status_code=""/>
      <ManipulationAction task_name="vision/enable_transport_vision_switch"
                          yaml_args=""
                          arm_error=""
                          status_code=""/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigationLocationAgvNewRobotSignal">
