              <Sequence _description="表示没有设置这个地图,0.未设置该地图"
                        _skipIf="map_self_str!=&quot;0&quot;">
                <TtsClient tts="设置地图"/>
                <Fallback>
                  <MappingOperations command="map_set"
                                     map_name="utars_charge_map"
                                     nav_error="{map_set_error_msg}"/>
                  <ForceFailure>
                    <Sequence>
                      <TtsClient tts="{map_set_error_msg}"/>
                    </Sequence>
                  </ForceFailure>
                </Fallback>
                <RetryUntilSuccessful num_attempts="3">
                  <Fallback>
                    <Sequence>
                      <Delay delay_msec="300">
                        <RelocationActuator command="relocation_start"
                                            mode="global"
                                            relocation_x="0"
                                            relocation_y="0"
                                            relocation_z="0"
                                            nav_error="{relocation_error_msg}"/>
                      </Delay>
                    </Sequence>
                    <ForceFailure>
                      <Sequence>
                        <TtsClient tts="{relocation_error_msg}"/>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>
              </Sequence>
            </Sequence>
            <Sequence _skipIf="nav_code_str!=&quot;1200006&quot; &amp;&amp; nav_code_str!=&quot;1200007&quot;">
              <ForceSuccess>
                <TtsClient tts="导航定位成功"/>
              </ForceSuccess>
            </Sequence>
          </Sequence>
          <Sequence _description="该节点配合上桩节点一起操作，上桩时候，设置true，上桩结束后要翻转false">
            <GlobalVarCondition set_global_str=""
                                current_global_str="{current_global_str}"/>
            <Sequence _skipIf="current_global_str!=&quot;1&quot;">
              <Sequence _description="在充电状态，并且电量大于40%符合工作条件，&#10;发送缩桩操作，如果还通电，则说明是手动充电"
                        _skipIf="battery_charge_state!=&quot;1&quot; || battery_low_power&lt;=40">
                <Sequence>
                  <ForceSuccess>
                    <TtsClient tts="我要开始下桩操作"/>
                  </ForceSuccess>
                  <SubTree ID="logo_nav_get_off"/>
                  <Delay delay_msec="10000">
                    <AgvChargeBatteryPowerStatusCondition battery_power="{battery_low_power}"
                                                          battery_charge_state="{battery_charge_state}"
                                                          _description="battery_charge_state #充电桩工作状态  #空闲 0  充电中 1"/>
                  </Delay>
                  <Sequence _skipIf="battery_charge_state!=&quot;1&quot;">
                    <SetTaskStateServer set_running="false"/>
                    <ForceFailure>
                      <TtsClient tts="当前机器人连接充电器，拒绝执行任务"/>
                    </ForceFailure>
                  </Sequence>
                </Sequence>
              </Sequence>
              <Sequence _description="在充电状态，并且电量大于40%符合工作条件，&#10;发送缩桩操作，如果还通电，则说明是手动充电"
                        _skipIf="battery_low_power&gt;40">
                <ForceFailure>
                  <TtsClient tts="当前电池电量低于百分之40，拒绝执行任务"/>
                </ForceFailure>
              </Sequence>
            </Sequence>
          </Sequence>
        </Sequence>
      </Sequence>
      <ManipulationAction task_name="cruzr/home"
                          yaml_args=""
                          arm_error=""
                          status_code=""/>
      <ManipulationAction task_name="vision/enable_transport_vision_switch"
                          yaml_args=""
                          arm_error=""
                          status_code=""/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigationLocationRobotSignal">
    <Sequence>
      <ParallelAll max_failures="1">
        <ManipulationAction task_name="cruzr/open_arm_before_home"
                            yaml_args=""
                            arm_error=""
                            status_code=""/>
        <Sequence>
          <Script code="map_self_str:=&quot;0&quot;"/>
          <Sequence _description="导航重定位判断节点">
            <MappingNameGain command="get_map_name"
                             map_name="utars_nav_map"
                             map_self="{map_self_str}"
                             _description="检测地图是否存在"/>
            <Sequence>
              <StartRobotSignal input_device="system"
                                last_time_stamp="{last_time_stamp}"
                                current_time_stamp="{current_time_stamp}"
                                is_first_start="{is_first_start}"/>
              <Script code="last_time_stamp:=current_time_stamp"/>
              <Switch2 case_1="0"
                       case_2="1"
                       variable="{is_first_start}">
                <Script code="map_self_str:=&quot;1&quot;"/>
                <Script code="map_self_str:=&quot;0&quot;"/>
                <ForceSuccess>
                  <TtsClient tts="获取启动标识参数异常"/>
                </ForceSuccess>
              </Switch2>
            </Sequence>
            <Sequence>
              <ParallelAll max_failures="1"
                           _description="检测是否设置了这个地图:1.已设置该地图"
                           _skipIf="map_self_str!=&quot;1&quot;">
                <ForceSuccess>
                  <TtsClient tts="检测地图"/>
                </ForceSuccess>
                <NavigationCheck command="check_state"
                                 nav_code="{nav_code_str}"
                                 map_self="{map_self_str}"
                                 _description="获取地图code"/>
              </ParallelAll>
              <Sequence _description="表示没有设置这个地图,0.未设置该地图"
                        _skipIf="map_self_str!=&quot;0&quot;">
                <ParallelAll max_failures="1">
                  <ForceSuccess>
                    <TtsClient tts="设置地图"/>
                  </ForceSuccess>
                  <Fallback>
                    <MappingOperations command="map_set"
                                       map_name="utars_nav_map"
                                       nav_error="{map_set_error_msg}"/>
                    <ForceFailure>
                      <TtsClient tts="{map_set_error_msg}"/>
                    </ForceFailure>
                  </Fallback>
                </ParallelAll>
                <RetryUntilSuccessful num_attempts="3">
                  <Fallback>
                    <Delay delay_msec="300">
                      <RelocationActuator command="relocation_start"
                                          mode="global"
                                          relocation_x="0"
                                          relocation_y="0"
                                          relocation_z="0"
                                          nav_error="{relocation_error_msg}"/>
                    </Delay>
                    <ForceFailure>
                      <TtsClient tts="{relocation_error_msg}"/>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>
              </Sequence>
            </Sequence>
          </Sequence>
        </Sequence>
      </ParallelAll>
      <ParallelAll max_failures="1">
        <ForceSuccess>
          <TtsClient tts="导航定位成功"/>
        </ForceSuccess>
        <ManipulationAction task_name="vision/enable_transport_vision_switch"
                            yaml_args=""
                            arm_error=""
                            status_code=""/>
      </ParallelAll>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigationModelSelect">
    <Sequence name="导航方式选择">
      <EnvExistCondition name="获取导航类型环境变量"
                         env_name="NAV_LOGO_MODEL_ENV"
                         env_value="logo_nav"
                         env_exist="{env_exist}"/>
      <Switch2 case_1="1"
               case_2="0"
               variable="{env_exist}"
               _description="logo_nav:自由导航方式,&quot;1&quot;&#10;logo_nav:不是logo_nav，巡线导航方式,&quot;0&quot;">
        <Script code="out_navi_type:=&quot;logo_nav&quot;"/>
        <Script code="out_navi_type:=&quot;logo_track_nav&quot;"/>
        <ForceSuccess>
          <TtsClient tts="获取导航类型环境变量参数异常"/>
        </ForceSuccess>
      </Switch2>
      <Script code="navi_type=out_navi_type"/>
      <EnvExistCondition name="获取导航充电桩类型环境变量"
                         env_name="NAV_CHARGE_TYPE_ENV"
                         env_value="not_charge"
                         env_exist="{env_charge_exist}"/>
      <Switch2 case_1="1"
               case_2="0"
               variable="{env_charge_exist}">
        <SubTree ID="NavigationLocationRobotSignal"
                 last_time_stamp="{last_time_stamp_str}"/>
        <SubTree ID="NavigationLocationAgvNewRobotSignal"
                 last_time_stamp="{last_time_stamp_str}"/>
        <ForceSuccess>
          <TtsClient tts="获取导航充电桩类型环境变量参数异常"/>
        </ForceSuccess>
      </Switch2>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SetMap">
    <TtsClient tts="设置地图111"/>
  </BehaviorTree>

  <BehaviorTree ID="logo_nav_get_off">
    <ForceSuccess>
      <RetryUntilSuccessful num_attempts="3">
        <Fallback>
          <Sequence>
            <Delay delay_msec="300">
              <NavigationActuator command="charging_start"
                                  mode="get_off"
                                  target_id=""
                                  nav_error="{to_put_error_msg}"/>
            </Delay>
            <GlobalVarCondition set_global_str="0"
                                current_global_str="{current_global_str}"/>
          </Sequence>
          <ForceFailure>
            <Delay delay_msec="500">
              <TtsClient tts="{to_put_error_msg}"/>
            </Delay>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="logo_nav_get_on">
    <ForceSuccess>
      <RetryUntilSuccessful num_attempts="3">
        <Fallback>
          <Sequence>
            <Delay delay_msec="300">
              <NavigationActuator command="charging_start"
                                  mode="get_on"
                                  target_id=""
                                  nav_error="{to_put_error_msg}"/>
            </Delay>
            <GlobalVarCondition set_global_str="1"
                                current_global_str="{current_global_str}"/>
          </Sequence>
          <ForceFailure>
            <Sequence>
              <Delay delay_msec="500">
                <TtsClient tts="{to_put_error_msg}"/>
              </Delay>
              <ForceSuccess>
                <SubTree ID="logo_nav_charge0"/>
              </ForceSuccess>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="logo_navi">
    <RetryUntilSuccessful num_attempts="5">
      <Fallback>
        <NavigationActuator command="navigation_start"
                            mode="{mode}"
                            target_id="{target_id}"
                            nav_error="{to_put_error_msg}"/>
        <ForceFailure>
          <Delay delay_msec="500">
            <TtsClient tts="{to_put_error_msg}"/>
          </Delay>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AgvChargeBatteryPowerStatusCondition"
            editable="true">
      <inout_port name="battery_power">当前机器电池电量值</inout_port>
      <inout_port name="battery_charge_state">当前机器电池是否在充电（1为是，0为否）</inout_port>
    </Action>
    <Action ID="AgvChargePoleClient"
            editable="true">
      <input_port name="type"
                  default="1"/>
      <input_port name="ip"
                  default="192.168.11.99"/>
      <output_port name="pole_message"/>
    </Action>
    <Condition ID="EnvExistCondition"
               editable="true">
      <input_port name="env_name"/>
      <input_port name="env_value"/>
      <output_port name="env_exist"/>
    </Condition>
    <Condition ID="GlobalVarCondition"
               editable="true">
      <input_port name="set_global_str"/>
      <output_port name="current_global_str"/>
    </Condition>
    <Action ID="ManipulationAction"
            editable="true">
      <input_port name="task_name"/>
      <input_port name="yaml_args"/>
      <output_port name="arm_error"/>
      <output_port name="status_code"/>
    </Action>
    <Action ID="MappingNameGain"
            editable="true">
      <input_port name="command"/>
      <input_port name="map_name"/>
      <output_port name="map_self"/>
    </Action>
    <Action ID="MappingOperations"
            editable="true">
      <input_port name="command"/>
      <input_port name="map_name"/>
      <inout_port name="nav_error"/>
    </Action>
    <Action ID="NavigationActuator"
            editable="true">
      <input_port name="command"/>
      <input_port name="mode"/>
      <input_port name="target_id"/>
      <input_port name="nav_error"/>
    </Action>
    <Action ID="NavigationCheck"
            editable="true">
      <input_port name="command"/>
      <output_port name="nav_code"/>
      <output_port name="map_self"/>
    </Action>
    <Action ID="RelocationActuator"
            editable="true">
      <input_port name="command"/>
      <input_port name="mode"/>
      <input_port name="relocation_x"/>
      <input_port name="relocation_y"/>
      <input_port name="relocation_z"/>
      <inout_port name="nav_error"/>
    </Action>
    <Action ID="SetTaskStateServer"
            editable="true">
      <input_port name="set_running"/>
    </Action>
    <Action ID="StartRobotSignal"
            editable="true">
      <input_port name="input_device"/>
      <input_port name="last_time_stamp"/>
      <output_port name="current_time_stamp"/>
      <output_port name="is_first_start"/>
    </Action>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
  </TreeNodesModel>

</root>
