<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="test">
  <BehaviorTree ID="test">
    <ParallelAll name="root"
                 max_failures="1">
      <ForceSuccess>
        <TtsClient tts="我要开始工作啦"/>
      </ForceSuccess>
      <Sequence>
        <PlcCommunicationCondition cmd="start_tcp_service"
                                   pos1_has_box="{pos1_has_box}"
                                   pos2_has_box="{pos2_has_box}"
                                   is_placing_box="{is_placing_box}"
                                   send_success="{send_plc_success}"/>
        <Repeat num_cycles="-1">
          <Sequence>
            <ForceSuccess>
              <TtsClient tts="当前is_placing_box的值是："/>
            </ForceSuccess>
            <Delay delay_msec="3000">
              <ForceSuccess>
                <TtsClient tts="{is_placing_box}"/>
              </ForceSuccess>
            </Delay>
            <Sequence _description="pos1_has_box: 1.位置一有箱子；0.位置一没有箱子&#10;pos2_has_box: 1.位置二有箱子；0.位置二没有箱子&#10;is_placing_box: 1.机器人正在工作，禁止入内；0.机器人未工作，可以入内"
                      _skipIf="is_placing_box!=&quot;0&quot;">
              <Sequence _description="pos1_has_box: 1.位置一有箱子；0.位置一没有箱子&#10;pos2_has_box: 1.位置二有箱子；0.位置二没有箱子&#10;is_placing_box: 1.机器人正在工作，禁止入内；0.机器人未工作，可以入内"
                        _skipIf="pos1_has_box!=&quot;1&quot;">
                <PlcCommunicationCondition cmd="robot_in_pick"
                                           pos1_has_box=""
                                           pos2_has_box=""
                                           is_placing_box=""
                                           send_success="{send_plc_success}"/>
                <Sequence _skipIf="send_plc_success!=&quot;1&quot;">
                  <Delay delay_msec="3000">
                    <ForceSuccess>
                      <TtsClient tts="我要去一号位置拿箱子"/>
                    </ForceSuccess>
                  </Delay>
                  <PlcCommunicationCondition cmd="robot_out_pick"
                                             pos1_has_box=""
                                             pos2_has_box=""
                                             is_placing_box=""
                                             send_success=""/>
                  <Sequence>
                    <Delay delay_msec="1000">
                      <ForceSuccess>
                        <TtsClient tts="箱子已放置完毕"/>
                      </ForceSuccess>
                    </Delay>
                  </Sequence>
                  <CtuCommunicationCondition cmd="point1_pick_arrived"
                                             send_success="{send_ctu_success}"/>
                  <Sequence _skipIf="send_ctu_success!=&quot;1&quot;">
                    <TtsClient tts="一号位置ctu指令发送成功"/>
                  </Sequence>
                  <Sequence _skipIf="send_ctu_success!=&quot;0&quot;">
                    <TtsClient tts="一号位置ctu指令发送失败"/>
                  </Sequence>
                </Sequence>
              </Sequence>
              <Sequence _description="pos1_has_box: 1.位置一有箱子；0.位置一没有箱子&#10;pos2_has_box: 1.位置二有箱子；0.位置二没有箱子&#10;is_placing_box: 1.机器人正在工作，禁止入内；0.机器人未工作，可以入内"
                        _skipIf="pos2_has_box!=&quot;1&quot;">
                <PlcCommunicationCondition cmd="robot_in_pick"
                                           pos1_has_box=""
                                           pos2_has_box=""
                                           is_placing_box=""
                                           send_success="{send_plc_success}"/>
                <Sequence _skipIf="send_plc_success!=&quot;1&quot;">
                  <Delay delay_msec="3000">
                    <ForceSuccess>
                      <TtsClient tts="我要去二号位置拿箱子"/>
                    </ForceSuccess>
                  </Delay>
                  <PlcCommunicationCondition cmd="robot_out_pick"
                                             pos1_has_box=""
                                             pos2_has_box=""
                                             is_placing_box=""
                                             send_success=""/>
                  <Sequence>
                    <Delay delay_msec="1000">
                      <ForceSuccess>
                        <TtsClient tts="箱子已放置完毕"/>
                      </ForceSuccess>
                    </Delay>
                  </Sequence>
                  <CtuCommunicationCondition cmd="point1_pick_arrived"
                                             send_success="{send_ctu_success}"/>
                  <Sequence _skipIf="send_ctu_success!=&quot;1&quot;">
                    <TtsClient tts="二号位置ctu指令发送成功"/>
                  </Sequence>
                  <Sequence _skipIf="send_ctu_success!=&quot;0&quot;">
                    <TtsClient tts="二号位置ctu指令发送失败"/>
                  </Sequence>
                </Sequence>
              </Sequence>
            </Sequence>
          </Sequence>
        </Repeat>
      </Sequence>
    </ParallelAll>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="CtuCommunicationCondition"
               editable="true">
      <input_port name="cmd"/>
      <inout_port name="send_success"/>
    </Condition>
    <Condition ID="PlcCommunicationCondition"
               editable="true">
      <input_port name="cmd"/>
      <output_port name="pos1_has_box"/>
      <output_port name="pos2_has_box"/>
      <output_port name="is_placing_box"/>
      <output_port name="send_success"/>
    </Condition>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
  </TreeNodesModel>

</root>
