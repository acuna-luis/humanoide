<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="test">
  <BehaviorTree ID="test">
    <ParallelAll name="root"
                 max_failures="1">
      <TtsClient tts="我要开始工作啦"/>
      <Script code=" taskControl:=&apos;void&apos;"/>
      <Script code=" flysky:=1"/>
      <RemoteControlNode taskControl="{taskControl}"/>
      <TaskSequenceNode taskControl="{taskControl}"
                        finish="false">
        <SequenceWithMemory>
          <Sequence>
            <Sequence _description="导航重定位判断节点">
              <MappingNameGain command="get_map_name"
                               map_name="utars_zhucheng_map"
                               map_self="{map_self_str}"
                               _description="检测地图是否存在"/>
              <Sequence>
                <Sequence _description="检测是否设置了这个地图:1.已设置该地图"
                          _skipIf="map_self_str!=&quot;1&quot;">
                  <TtsClient tts="检测地图"/>
                  <Sequence>
                    <NavigationCheck command="check_state"
                                     nav_code="{nav_code_str}"
                                     map_self="{map_self_str}"
                                     _description="获取地图code"/>
                  </Sequence>
                </Sequence>
                <Sequence _description="表示没有设置这个地图,0.未设置该地图"
                          _skipIf="map_self_str!=&quot;0&quot;">
                  <TtsClient tts="设置地图"/>
                  <Fallback>
                    <MappingOperations command="map_set"
                                       map_name="utars_zhucheng_map"
                                       nav_error="{map_set_error_msg}"/>
                    <ForceFailure>
                      <Sequence>
                        <TtsClient tts="{map_set_error_msg}"/>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                  <Fallback>
                    <RetryUntilSuccessful num_attempts="3">
                      <Sequence>
                        <RelocationActuator command="relocation_start"
                                            mode="global"
                                            relocation_x="0"
                                            relocation_y="0"
                                            relocation_z="0"
                                            nav_error="{relocation_error_msg}"/>
                      </Sequence>
                    </RetryUntilSuccessful>
                    <ForceFailure>
                      <Sequence>
                        <TtsClient tts="{relocation_error_msg}"/>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </Sequence>
              </Sequence>
              <TtsClient tts="导航定位成功"/>
            </Sequence>
            <ManipulationAction task_name="cruzr/home"
                                yaml_args=""/>
            <ManipulationAction task_name="vision/enable_transport_vision_switch"
                                yaml_args=""/>
          </Sequence>
          <SequenceWithMemory>
            <Sequence _description="上面层操作">
              <Sequence _description="上面层大箱子操作">
                <Sequence _description="搬上面层大箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="get2"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <Sequence>
                        <Delay delay_msec="200">
                          <ManipulationAction task_name="cruzr/clamp_cruzr_byd_large"
                                              yaml_args=""/>
                        </Delay>
                      </Sequence>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="100">
                            <TtsClient tts="需要帮助移动一下箱子"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                </Sequence>
                <Sequence _description="放上面层大箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="put1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <Sequence>
                    <ManipulationAction task_name="cruzr/put_cruzr_byd_large"
                                        yaml_args=""/>
                    <ManipulationAction task_name="cruzr/home"
                                        yaml_args=""/>
                  </Sequence>
                </Sequence>
              </Sequence>
              <Sequence _description="上面层小箱子操作">
                <Sequence _description="搬上面层小箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="get1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <Sequence>
                        <Delay delay_msec="200">
                          <ManipulationAction task_name="cruzr/clamp_cruzr_byd_small"
                                              yaml_args=""/>
                        </Delay>
                      </Sequence>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="100">
                            <TtsClient tts="需要帮助移动一下箱子"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                </Sequence>
                <Sequence _description="放上面层小箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="put1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <ManipulationAction task_name="cruzr/put_cruzr_byd_small"
                                      yaml_args=""/>
                  <ManipulationAction task_name="cruzr/home"
                                      yaml_args=""/>
                </Sequence>
              </Sequence>
            </Sequence>
            <Sequence _description="下面层操作">
              <Sequence _description="下面大箱子操作">
                <Sequence _description="搬下面层大箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="get2"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <ManipulationAction task_name="cruzr/half_back_sit"
                                      yaml_args=""/>
                  <RetryUntilSuccessful num_attempts="10">
                    <Fallback>
                      <Sequence>
                        <Delay delay_msec="200">
                          <ManipulationAction task_name="cruzr/clamp_cruzr_byd_large"
                                              yaml_args=""/>
                        </Delay>
                      </Sequence>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="100">
                            <TtsClient tts="需要帮助移动一下箱子"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                </Sequence>
                <Sequence _description="放下面层大箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="put1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <Sequence>
                    <ManipulationAction task_name="cruzr/put_cruzr_byd_large"
                                        yaml_args=""/>
                    <ManipulationAction task_name="cruzr/home"
                                        yaml_args=""/>
                  </Sequence>
                </Sequence>
              </Sequence>
              <Sequence _description="下面小箱子操作">
                <Sequence _description="搬下面层小箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="get1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <ManipulationAction task_name="cruzr/half_back_sit"
                                      yaml_args=""/>
                  <RetryUntilSuccessful num_attempts="10">
                    <Fallback>
                      <Sequence>
                        <Delay delay_msec="200">
                          <ManipulationAction task_name="cruzr/clamp_cruzr_byd_small"
                                              yaml_args=""/>
                        </Delay>
                      </Sequence>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="100">
                            <TtsClient tts="需要帮助移动一下箱子"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                </Sequence>
                <Sequence _description="放下面层小箱子操作">
                  <RetryUntilSuccessful num_attempts="5">
                    <Fallback>
                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="put1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <ManipulationAction task_name="cruzr/put_cruzr_byd_small"
                                      yaml_args=""/>
                  <ManipulationAction task_name="cruzr/home"
                                      yaml_args=""/>
                  <TtsClient tts="任务完成"/>
                </Sequence>
              </Sequence>
            </Sequence>
          </SequenceWithMemory>
        </SequenceWithMemory>
      </TaskSequenceNode>
    </ParallelAll>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ManipulationAction"
            editable="true">
      <input_port name="task_name"/>
      <input_port name="yaml_args"/>
    </Action>
    <Action ID="MappingOperations"
            editable="true">
      <input_port name="command"/>
      <input_port name="map_name"/>
      <inout_port name="nav_error"/>
    </Action>
    <Action ID="NavigationActuator"
            editable="true">
      <input_port name="command"/>
      <input_port name="mode"/>
      <input_port name="target_id"/>
      <input_port name="nav_error"/>
    </Action>
    <Action ID="RelocationActuator"
            editable="true">
      <input_port name="command"/>
      <input_port name="mode"/>
      <input_port name="relocation_x"/>
      <input_port name="relocation_y"/>
      <input_port name="relocation_z"/>
      <inout_port name="nav_error"/>
    </Action>
    <Action ID="RemoteControlNode"
            editable="true">
      <input_port name="taskControl"/>
    </Action>
    <Decorator ID="TaskSequenceNode"
               editable="true">
      <input_port name="taskControl"/>
      <input_port name="finish"/>
    </Decorator>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
  </TreeNodesModel>

</root>
