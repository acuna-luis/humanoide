                      <NavigationActuator command="navigation_start"
                                          mode="logo_nav"
                                          target_id="get1"
                                          nav_error="{to_put_error_msg}"/>
                      <ForceFailure>
                        <Sequence>
                          <Delay delay_msec="1000">
                            <TtsClient tts="{to_put_error_msg}"/>
                          </Delay>
                          <NavigationActuator command="navigation_start"
                                              mode="logo_nav"
                                              target_id="get1"
                                              nav_error="{to_put_error_msg}"/>
                        </Sequence>
                      </ForceFailure>
                    </Fallback>
                  </RetryUntilSuccessful>
                  <Delay delay_msec="200">
                    <TtsClient tts="我开始拆垛动作"/>
                  </Delay>
                  <Delay delay_msec="200">
                    <TtsClient tts="我要开始搬箱子动作了"/>
                  </Delay>
                </Sequence>
                <Sequence _description="放上面层大箱子操作">
