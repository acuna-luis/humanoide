  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <SubTree ID="LogoNavParameter"
             editable="true">
      <input_port name="logo_nav_par"/>
    </SubTree>
    <Action ID="ManipulationAction"
            editable="true">
      <input_port name="task_name"/>
      <input_port name="yaml_args"/>
      <output_port name="arm_error"/>
      <output_port name="status_code"/>
    </Action>
    <Action ID="RemoteControlNode">
      <output_port name="taskControl"
                   type="std::string"/>
    </Action>
    <Control ID="TaskSequenceNode"
             editable="true">
      <input_port name="taskControl"/>
      <input_port name="finish"/>
    </Control>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
    <Action ID="getNavPoseFromMotionClient"
            editable="true">
      <output_port name="point_x"
                   type="std::vector&lt;float"/>
      <output_port name="point_y"
                   type="std::vector&lt;float"/>
      <output_port name="point_yaw"
                   type="std::vector&lt;float"/>
      <output_port name="restMessage"
                   type="std::string"/>
    </Action>
    <SubTree ID="nav_pose_lock1"
             editable="true">
      <input_port name="point_x"/>
      <input_port name="point_y"/>
      <input_port name="point_yaw"/>
    </SubTree>
  </TreeNodesModel>

</root>
