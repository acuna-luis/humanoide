<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="test">
  <include path="subtrees/Navigation/navigation.xml"/>
  <include path="subtrees/Manipulation/manipulation.xml"/>

  <BehaviorTree ID="test">
    <ParallelAll name="root"
                 max_failures="1">
      <ForceSuccess>
        <TtsClient tts="我要开始工作啦"
                   _onSuccess="grab_box_status:=0;grab_box_error:=&quot;&quot;"/>
      </ForceSuccess>
      <Script code=" taskControl:=&apos;void&apos;"/>
      <Script code=" flysky:=1"/>
      <RemoteControlNode taskControl="{taskControl}"/>
      <TaskSequenceNode taskControl="{taskControl}"
                        finish="false">
        <SequenceWithMemory>
          <SubTree ID="NavigationLocation"/>
          <Sequence _description="上面层大箱子操作">
            <Sequence _description="搬上面层大箱子操作">
              <SubTree ID="logo_nav_get1"/>
              <SubTree ID="ManipulationSubTreeGrabBox"
                       TaskName="jiepu/clamp_table_tray1020"
                       boxSize="boxSize=[0.41, 0.261, 0.238]"
                       grabHeight="grabHeight=1.02"
                       port_map="grab_box_status:=grab_box_status;grab_box_error:=grab_box_error"/>
              <ManipulationAction task_name="cruzr/mobot_back_40"
                                  yaml_args=""
                                  arm_error=""
                                  status_code=""/>
            </Sequence>
            <Sequence _description="放上面层大箱子操作">
              <SubTree ID="logo_nav_put1"/>
              <Sequence>
                <SubTree ID="ManipulationSubTreePutBox"
                         TaskName="jiepu/put_tray_cruzr"
                         boxSize="boxSize=[0.41, 0.261, 0.238]"
                         putHeight="grabHeight=0.8"
                         port_map="grab_box_status:=grab_box_status;grab_box_error:=grab_box_error"/>
              </Sequence>
              <Sequence>
                <ManipulationAction task_name="cruzr/mobot_back_40"
                                    yaml_args=""
                                    arm_error=""
                                    status_code=""/>
                <Delay delay_msec="200">
                  <ManipulationAction task_name="jiepu/loose_hand_open_cruzr"
                                      yaml_args=""
                                      arm_error=""
                                      status_code=""/>
                </Delay>
                <ManipulationAction task_name="cruzr/home"
                                    yaml_args=""
                                    arm_error=""
                                    status_code=""/>
              </Sequence>
            </Sequence>
          </Sequence>
        </SequenceWithMemory>
      </TaskSequenceNode>
    </ParallelAll>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ManipulationAction"
            editable="true">
      <input_port name="task_name"/>
      <input_port name="yaml_args"/>
      <output_port name="arm_error"/>
      <output_port name="status_code"/>
    </Action>
    <Action ID="RemoteControlNode"
            editable="true">
      <input_port name="taskControl"/>
    </Action>
    <Decorator ID="TaskSequenceNode"
               editable="true">
      <input_port name="taskControl"/>
      <input_port name="finish"/>
    </Decorator>
    <Action ID="TtsClient"
            editable="true">
      <input_port name="tts"/>
    </Action>
  </TreeNodesModel>

</root>
