[Unit]
Description=Cruzr boot self-check watchdog (E-stop-gated Control Center restart, no motion)
After=docker.service

[Service]
Type=simple
User=walker
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /etc/walker/boot/cruzr_selfcheck_watchdog.py --watch
TimeoutStopSec=10
Restart=no

[Install]
WantedBy=multi-user.target
