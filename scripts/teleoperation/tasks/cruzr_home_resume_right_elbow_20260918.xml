<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <!-- One-shot recovery for the 2026-09-18 15:27 CST state only: body at zero,
             left arm already opened by body-first v4, right arm not opened and
             R_elbow_roll 0.028 rad above its 0.0187 soft limit. Completes v4. -->
        <Sequence name="resume_home_after_right_elbow_limit">
            <Action ID="MetaMove" type="arm" location="right" duration="1.500" delta_joint_angles="0; 0; 0; -0.03; 0; 0; 0" />
            <Action ID="MetaMove" type="arm" location="right" duration="2.500" delta_joint_angles="0; -0.4; 0; 0; 0; 0; 0" />
            <Parallel name="lower_arms_while_open" threshold="2">
                <Action ID="MetaMove" type="arm" location="left" duration="10.000" joint_angles="0; -0.6; 0; 0; 0; 0; 0" />
                <Action ID="MetaMove" type="arm" location="right" duration="10.000" joint_angles="0; -0.6; 0; 0; 0; 0; 0" />
            </Parallel>
            <Parallel name="close_lowered_arms" threshold="2">
                <Action ID="MetaMove" type="arm" location="left" duration="3.750" joint_angles="0; 0; 0; 0; 0; 0; 0" />
                <Action ID="MetaMove" type="arm" location="right" duration="3.750" joint_angles="0; 0; 0; 0; 0; 0; 0" />
            </Parallel>
        </Sequence>
    </BehaviorTree>
</root>
